{
  "name": "carbmaxx",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "CARBMAXX 2.0: local-first nutrition ledger, planner and training tracker for GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
